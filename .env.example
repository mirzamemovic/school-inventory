APP_NAME="School Inventory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Printed on every QR sticker. Must be the final address before any label is
# printed. See DEPLOYMENT.md.
APP_URL=http://localhost:8000

# The fixed start of every asset tag, for example INV-PC-0142. Set it once, before
# the first label is printed: a tag can never change after that.
SCHOOL_TAG_PREFIX=INV

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Secure cookies are on by default when APP_ENV=production.
# SESSION_SECURE_COOKIE=true

# "Keep me signed in" lasts 14 days. See DEPLOYMENT.md before changing it.
# AUTH_REMEMBER_MINUTES=20160

# Plain HTTP is redirected to HTTPS in production. Set false only if the host
# already redirects and the two loop.
# SCHOOL_FORCE_HTTPS=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
